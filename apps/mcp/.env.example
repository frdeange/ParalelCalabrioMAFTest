# ---------------------------------------------------------------------------
# Local development environment for ``apps/mcp``.
#
# Copy to ``.env`` and adjust. Settings consumed by ``app/settings.py``.
# PLAN.md §14 ("MCP") tracks the full production variable set; the
# subset below grows issue-by-issue.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Streamable HTTP transport (issue #16)
# ---------------------------------------------------------------------------

# Path the Streamable HTTP transport listens on. Backend's
# ``MCPStreamableHTTPTool`` consumers point at ``${MCP_BASE_URL}${MCP_PATH}``.
MCP_PATH=/mcp/

# Stateless Streamable HTTP: every request gets a fresh transport, no
# server-side session bookkeeping. Required by PLAN.md §6.3.
MCP_STATELESS=true

# Logging level applied via ``logging.basicConfig`` in ``app/main.py``.
MCP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Azure SQL connection (issue #17)
# ---------------------------------------------------------------------------
# Entra-only auth via DefaultAzureCredential. SQL passwords are
# explicitly forbidden — there is no username / password / KV-secret
# fallback. Key Vault is consumed only for the HMAC shared secret
# (issue #47), not for SQL credentials.
MCP_AZURE_SQL_SERVER=calabriomafpoc-sql.database.windows.net
MCP_AZURE_SQL_DATABASE=calabriowfm

# Pin the User-Assigned Managed Identity used for SQL access tokens.
# Leave empty for the System-Assigned MI or when only one UAMI is
# attached. Required when multiple UAMIs coexist on the host so MSAL
# does not pick the wrong one.
MCP_AZURE_SQL_MANAGED_IDENTITY_CLIENT_ID=

# ``local`` (developer) or ``azure`` (production). Drives the
# DefaultAzureCredential lockdown: locally only ``az login`` is
# allowed, in Azure only Managed Identity is allowed. Other credential
# types — EnvironmentCredential (honours AZURE_CLIENT_SECRET),
# InteractiveBrowser, VSCode, etc. — are unconditionally disabled to
# prevent an SQL-password code path from sneaking in through the side
# door.
MCP_ENVIRONMENT=local
