# Entra ID / Azure AD - copy to .env.local and fill in values
# These are NEXT_PUBLIC_ so they are embedded in the client bundle (non-secret)

# Application (client) ID from your Entra ID App Registration
NEXT_PUBLIC_AZURE_CLIENT_ID=

# Directory (tenant) ID  
NEXT_PUBLIC_AZURE_TENANT_ID=

# Post-login redirect URI (must match registered redirect URI in Entra ID)
# Dev: http://localhost:3000
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000

# API scope for acquiring tokens for backend calls (issue #27)
NEXT_PUBLIC_API_SCOPE=api://calabrio-wfm/.default

# Backend AG-UI endpoint — MUST be the APIM `chat-api-*` gateway route,
# NOT the backend container directly. The backend's /agui route requires
# APIM-injected identity headers (x-user-*, x-apim-signature) and rejects
# unsigned direct calls (see apps/backend/app/deps/identity.py).
# Dev:  https://<apim-name>.azure-api.net/chat-api-dev
# Prod: https://<apim-name>.azure-api.net/chat-api-prod
# (Local-only without APIM requires a dev proxy that injects those headers.)
NEXT_PUBLIC_BACKEND_API_URL=https://<apim-name>.azure-api.net/chat-api-dev
# POC BU override (issue #28). When "true", the chat sidebar shows a BU
# selector; the chosen BU is sent as the `x-debug-bu` header and APIM uses
# it as the L3 layer of BU resolution. Leave unset/false in production.
NEXT_PUBLIC_POC_BU_OVERRIDE=false

# Comma-separated BU ids offered in the POC selector (optional).
NEXT_PUBLIC_POC_BU_OPTIONS=1,42,100