# =============================================================================
# WFM Data Assistant — backend (.env.example)
# =============================================================================
# Copy to `.env` and fill in the blanks for local development. In Azure
# Container Apps these come from KeyVault references / managed identity.
# Canonical inventory: PLAN.md §14.
# =============================================================================

# -----------------------------------------------------------------------------
# Foundry / model
# -----------------------------------------------------------------------------
# Azure AI Foundry project endpoint (https://<project>.<region>.ai.azure.com/api/projects/<id>)
FOUNDRY_PROJECT_ENDPOINT=

# Foundry chat model deployment used by the workflow agents.
FOUNDRY_DEPLOYMENT_NAME=gpt-5.2

# Alias kept for SDK clients that read it directly.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.2

# -----------------------------------------------------------------------------
# MCP (tool server)
# -----------------------------------------------------------------------------
# Public MCP entry point. Local dev points at the MCP container directly;
# in Azure it routes through the APIM `mcp-api-<env>` facade.
MCP_SERVER_URL=https://<apim>/mcp-api-dev/mcp/

# -----------------------------------------------------------------------------
# Cosmos DB (conversation history)
# -----------------------------------------------------------------------------
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE_NAME=agent-framework
AZURE_COSMOS_CONTAINER_NAME=chat-history

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Master switch for agent-framework instrumentation.
ENABLE_INSTRUMENTATION=true

# Emit prompts/responses in traces. Disable in production.
ENABLE_SENSITIVE_DATA=true

# Service name attached to every OTel span.
OTEL_SERVICE_NAME=wfm-backend

# -----------------------------------------------------------------------------
# Business Unit
# -----------------------------------------------------------------------------
# Fallback BU id used when APIM cannot resolve it from JWT claim,
# domain map or `x-debug-bu` header. See PLAN.md §4 D8.
BU_ID_DEFAULT=1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Shared secret used by APIM `hmac-sign` policy fragment. Sourced from
# KeyVault in production (PLAN.md §11).
HMAC_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
