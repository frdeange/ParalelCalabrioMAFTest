# Entra ID / Azure AD - copy to .env.local and fill in values
# These are NEXT_PUBLIC_ so they are embedded in the client bundle (non-secret)

# Application (client) ID from your Entra ID App Registration
NEXT_PUBLIC_AZURE_CLIENT_ID=

# Directory (tenant) ID  
NEXT_PUBLIC_AZURE_TENANT_ID=

# Post-login redirect URI (must match registered redirect URI in Entra ID)
# Dev: http://localhost:3000
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000

# API scope for acquiring tokens for backend calls (issue #27)
NEXT_PUBLIC_API_SCOPE=api://calabrio-wfm/.default

# Backend APIM endpoint for AG-UI chat
# Dev: http://localhost:8000
# Prod: https://api.calabrio.example.com
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
