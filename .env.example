# Sample .env for local development.
#
# Copy to `.env` and fill in your own values. `.env` is gitignored.
#
# Used by:
#   - `python main_local.py`     (local MAF orchestrator, local MCP)
#   - `python -m foundry_hosted.main_hosted`  (local Foundry hosted server)
#   - `python update_agents.py`  (publish/update the 3 Foundry Prompt Agents)
#
# For deployment, the same values flow through `azd env set <VAR> <VALUE>`
# and are injected at runtime by Foundry hosting.

# --- Required for ALL scripts ----------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-model-deployment-name>
MCP_SERVER_URL=<your-mcp-server-endpoint>
BU_ID=<integer-bu-id>

# --- Required by main_local.py (single-shot local CLI run) -----------------
USER_QUESTION=<your-question>

# --- Telemetry -------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>
OTEL_SERVICE_NAME=wfm-data-assistant
ENABLE_SENSITIVE_DATA=true
