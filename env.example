# Sample env file for local runs (`python main_v9.py`).
# Production values (FOUNDRY_PROJECT_ENDPOINT, AZURE_AI_MODEL_DEPLOYMENT_NAME,
# APPLICATIONINSIGHTS_CONNECTION_STRING) are injected by Foundry at runtime
# when deployed via `azd deploy`.

# Foundry project (only required for local dev).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment to call. Locally this is what FoundryChatClient uses.
# When deployed, Foundry overrides this with the env var injected at runtime.
FOUNDRY_MODEL=gpt-5.2

# Workflow scope (Business Unit) and remote MCP server.
BU_ID=1
MCP_SERVER_URL=https://<your-host>/mcp/

# Telemetry (local only; Foundry injects its own connection string in
# production).
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=true
